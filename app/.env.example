# PharmaFlow — hosted Supabase credentials.
#
# Copy this file to `.env` and fill in the values from the HOSTED project:
# Supabase Dashboard -> Project Settings -> API. `.env` is gitignored.
#
#   SUPABASE_URL=https://<project-ref>.supabase.co
#   SUPABASE_ANON_KEY=<anon / publishable key>
#
# Only the *anon* key belongs here. Never put the service_role key in a
# client-side Flutter app — it bypasses Row Level Security entirely.
#
# There is no local Supabase stack in this project, so nothing here comes from
# `supabase status`.

SUPABASE_URL=
SUPABASE_ANON_KEY=
